# Configurações do Sistema de Finanças Familiar
# Copie este arquivo para .env e configure os valores

# Chave secreta para sessões (MUDE ISSO!)
SECRET_KEY=sua-chave-super-secreta-aqui-mude-isso

# Banco de dados (local)
DATABASE_URL=sqlite:///instance/financas.db

# Ambiente (development, production)
FLASK_ENV=production

# Debug (True apenas em desenvolvimento)
DEBUG=False

# Host e Porta
HOST=0.0.0.0
PORT=5001

# Logs
LOG_LEVEL=INFO
LOG_FILE=logs/app.log

# Rate Limiting
RATELIMIT_ENABLED=True
RATELIMIT_DEFAULT=100 per hour
